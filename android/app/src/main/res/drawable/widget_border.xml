<?xml version="1.0" encoding="utf-8"?>
<!-- A fine edge around the card, like the polished rim of a pane of glass.
     The fill is explicitly transparent: without it, tinting this shape
     (see TideWidgetProvider) paints the whole card instead of only the rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke
        android:width="1dp"
        android:color="#FFFFFFFF" />
    <corners android:radius="24dp" />
</shape>
