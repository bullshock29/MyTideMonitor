<?xml version="1.0" encoding="utf-8"?>
<!-- A colorful backdrop for the preview on a widget's settings screen, so how
     see-through the glass is can be judged. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:centerColor="#4DB6AC"
        android:endColor="#5C6BC0"
        android:startColor="#FFB74D" />
    <corners android:radius="16dp" />
</shape>
